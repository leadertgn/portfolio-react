# Google OAuth 2.0 Client ID
# À récupérer sur Google Cloud Console : https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID="votre_google_client_id_ici"

# URL du backend (pour les requêtes API)
VITE_BACKEND_URL="http://localhost:5000"

# Email de l'administrateur (pour vérification côté frontend également)
VITE_ADMIN_EMAIL="votre_email@gmail.com"
