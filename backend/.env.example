# --- BASE DE DONNÉES ---
DATABASE_URL="postgresql://user:password@localhost:5432/portfolio?schema=public"

# --- GOOGLE AUTH ---
# Obtenu sur Google Cloud Console
GOOGLE_CLIENT_ID="ton-client-id.apps.googleusercontent.com"

# --- CONFIG ADMIN ---
# Seul cet email pourra modifier les données
ADMIN_EMAIL="ton-email@gmail.com"

# --- CLOUDINARY ---
# Obtenu sur le dashboard Cloudinary
CLOUDINARY_CLOUD_NAME="ton-cloud-name"
CLOUDINARY_API_KEY="ta-cle-api"
CLOUDINARY_API_SECRET="ton-secret-api"

# --- PRODUCTION ---
# URL de ton frontend (ex: https://leadertgn.me)
FRONTEND_URL="http://localhost:5173"

# URL de ton backend Render (ex: https://portfolio-api.onrender.com)
# Nécessaire pour le mécanisme "Keep Awake"
BACKEND_URL="http://localhost:5000"

# Port du serveur (Render définit cela automatiquement)
PORT=5000
